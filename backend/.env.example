DATABASE_URL="postgresql://fixflow_app:CHANGE_ME@localhost:5432/fixflow"
JWT_SECRET="CHANGE_ME_TO_A_LONG_RANDOM_STRING"
PORT=4000
CORS_ORIGIN="https://5-75-224-110.sslip.io"

# Generate once with `npm run license:keypair`; the public key is the same
# across every deployment, the private key stays offline and is used to
# issue each customer's LICENSE_KEY with `npm run license:generate`.
LICENSE_PUBLIC_KEY="CHANGE_ME_PASTE_PUBLIC_KEY_PEM"
LICENSE_KEY="CHANGE_ME_PASTE_CUSTOMER_LICENSE_KEY"
