generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---- Enums (values with no spaces / punctuation only) ----

enum Role {
  front_desk
  technician
  supervisor
  manager
  admin
}

enum JobType {
  warranty
  non_warranty
}

enum CustomerType {
  individual
  corporate
}

enum Gender {
  male
  female
}

enum PreferredLanguage {
  ar
  en
}

// Stage names, statuses, and other short display strings with spaces
// ("Warranty Validation", "In Diagnosis", "Ready for Handover", ...) are kept
// as plain String columns (validated by Zod in the API layer) rather than
// Postgres enums, since Postgres enum members can't contain spaces and
// mapping them would just add friction without real benefit at this scale.

model Branch {
  id            String         @id @default(cuid())
  name          String
  city          String
  customers     Customer[]
  technicians   Technician[]
  serviceOrders ServiceOrder[]
  jobCards      JobCard[]
  users         User[]
}

model User {
  id           String   @id @default(cuid())
  name         String
  username     String   @unique
  passwordHash String
  role         Role
  branchId     String
  branch       Branch   @relation(fields: [branchId], references: [id])
  createdAt    DateTime @default(now())
}

model RolePermission {
  id      String  @id @default(cuid())
  action  String
  role    Role
  allowed Boolean @default(true)

  @@unique([action, role])
}

model Customer {
  id                 String    @id @default(cuid())
  documentNo         String    @unique
  firstName          String?
  fatherName         String?
  grandfatherName    String?
  familyName         String?
  name               String
  firstNameAr        String?
  fatherNameAr       String?
  grandfatherNameAr  String?
  familyNameAr       String?
  nameAr             String?
  phone              String
  homePhone          String?
  whatsapp           String
  email              String?
  address            String?
  nationalId         String?
  nationality        String?
  preferredLanguage  PreferredLanguage?
  customerType       CustomerType @default(individual)
  companyName        String?
  crNumber           String?
  vatNumber          String?
  contactPersonName  String?
  dateOfBirth        DateTime?
  gender             Gender?
  notes              String?
  branchId           String
  branch             Branch    @relation(fields: [branchId], references: [id])
  createdAt          DateTime  @default(now())
  whatsappVerified   Boolean   @default(false)

  serviceOrders ServiceOrder[]
  jobCards      JobCard[]

  @@index([phone])
}

model Brand {
  id             String      @id @default(cuid())
  name           String
  nameAr         String?
  warrantyMonths Int
  rules          String
  appliances     Appliance[]
}

// Appliance category is a soft reference by name (Appliance.category is a
// plain String, not a FK) rather than a hard relation, so admins can add a
// brand-new category from the Categories page without a schema migration.
model Category {
  id                    String   @id @default(cuid())
  name                  String   @unique
  nameAr                String?
  code                  String?
  description           String?
  defaultWarrantyMonths Int?
  createdAt             DateTime @default(now())
}

// Soft reference like Category: InventoryItem.unit (mock/local data, not yet
// backend-persisted) stores this unit's name as plain text, not a FK.
model UnitOfMeasure {
  id               String   @id @default(cuid())
  name             String   @unique
  nameAr           String?
  code             String?
  unitType         String   @default("Base")
  roundingType     String?
  decimalPlaces    Int      @default(0)
  baseUnitName     String?
  conversionFactor Float?
  createdAt        DateTime @default(now())
}

model Appliance {
  id                String   @id @default(cuid())
  documentNo        String   @unique
  brandId           String
  brand             Brand    @relation(fields: [brandId], references: [id])
  category          String
  model             String
  modelAr           String?
  serialNo          String
  imeiNo            String?
  purchaseDate      DateTime
  warrantyStatus    String   @default("Unknown")
  isSmartConnected  Boolean  @default(false)
  purchaseInvoiceNo String?
  retailerName      String?
  purchasePrice     Float?
  amcActive         Boolean?
  amcExpiryDate     DateTime?
  sasoCertNo        String?
  energyRating      Int?
  countryOfManufacture String?
  color             String?
  specification     String?
  installationDate  DateTime?
  installedLocation String?
  photoUrl          String?
  notes             String?

  telemetry ApplianceTelemetry?
  jobCards  JobCard[]

  @@index([serialNo])
}

model ApplianceTelemetry {
  applianceId         String    @id
  appliance           Appliance @relation(fields: [applianceId], references: [id])
  lastErrorCode       String?
  lastErrorDescription String?
  cycleCount          Int       @default(0)
  lastSyncAt          DateTime  @default(now())
}

model Technician {
  id          String   @id @default(cuid())
  name        String
  nameAr      String?
  phone       String
  skills      String[]
  zone        String
  branchId    String
  branch      Branch   @relation(fields: [branchId], references: [id])
  status      String   @default("Available")
  avatarColor String   @default("#2a78d6")
  notes       String?

  jobCards JobCard[]
}

model ServiceOrder {
  id               String   @id @default(cuid())
  documentNo       String   @unique
  customerId       String
  customer         Customer @relation(fields: [customerId], references: [id])
  branchId         String
  branch           Branch   @relation(fields: [branchId], references: [id])
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  shortAddressCode String?
  buildingNo       String?
  unitNo           String?
  district         String?
  postalCode       String?
  additionalNo     String?
  requestSource    String?
  preferredDate    DateTime?
  preferredTimeSlot String?
  buyerVatNumber   String?

  jobCards JobCard[]
}

model JobCard {
  id              String   @id @default(cuid())
  serviceOrderId  String
  serviceOrder    ServiceOrder @relation(fields: [serviceOrderId], references: [id])
  sequenceNo      Int
  documentNo      String   @unique
  invoiceNo       String
  customerId      String
  customer        Customer @relation(fields: [customerId], references: [id])
  applianceId     String
  appliance       Appliance @relation(fields: [applianceId], references: [id])
  technicianId    String?
  technician      Technician? @relation(fields: [technicianId], references: [id])
  branchId        String
  branch          Branch   @relation(fields: [branchId], references: [id])
  jobType         JobType
  status          String
  currentStage    String
  problemDescription String
  estimateAmount  Float?
  finalAmount     Float?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  scheduledAt     DateTime?
  customerApproved Boolean?
  diagnosisNotes  String?
  repairNotes     String?
  qaApproved      Boolean  @default(false)
  customerSignature String?
  oemClaimNo      String?
  estimateValidUntil DateTime?
  estimatePreparedBy String?
  estimateTermsOfPayment String?
  estimatePoNumber String?
  estimateNotes   String?
  estimatePreviousQuoteNo String?
  estimateCustomerRequest String?
  estimateDeliveryLeadTime String?
  estimateSubject String?
  assetReceivedRef String?
  assetReceivedBy  String?
  assetReceivedAt  DateTime?
  assetHandedOver Boolean  @default(false)
  assetHandedOverRef String?
  assetHandedOverAt DateTime?
  assetHandedOverBy String?

  stageHistory JobCardStageHistory[]
  removedParts RemovedPart[]
  estimateLines EstimateLine[]

  @@index([currentStage])
}

// Estimate line items build up a job card's estimateAmount. These used to be
// browser-local-only state, which meant every estimate a user built vanished
// the moment job cards moved to real, server-generated IDs — so they're now
// real, persisted rows tied to the job card they belong to.
model EstimateLine {
  id             String   @id @default(cuid())
  jobcardId      String
  jobCard        JobCard  @relation(fields: [jobcardId], references: [id])
  kind           String
  catNo          String?
  label          String
  descriptionAr  String?
  notes          String?
  itemId         String?
  qty            Float
  unitPrice      Float
  discountAmount Float?
  totalPrice     Float
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([jobcardId])
}

model JobCardStageHistory {
  id         String   @id @default(cuid())
  jobcardId  String
  jobCard    JobCard  @relation(fields: [jobcardId], references: [id])
  stageName  String
  changedBy  String
  timestamp  DateTime @default(now())
  notes      String
  stageRefNo String?
}

// Inventory locations are not a stored table -- they're derived from real
// Branch rows (one "store" per branch, id `store-<branchId>`) and Technician
// rows (one "van" per technician, id `van-<technicianId>`), so there's never
// a separate location list to keep in sync as branches/technicians change.
// InventoryStock/InventoryTransaction.locationId is therefore a soft
// reference (plain String, like Category) rather than a FK.
model InventoryItem {
  id           String   @id @default(cuid())
  name         String
  nameAr       String?
  category     String
  brand        String
  partNo       String
  unit         String?
  unitPrice    Float
  reorderLevel Int
  notes        String?

  stock        InventoryStock[]
  transactions InventoryTransaction[]
}

model InventoryStock {
  id         String        @id @default(cuid())
  itemId     String
  item       InventoryItem @relation(fields: [itemId], references: [id])
  locationId String
  qty        Int

  @@unique([itemId, locationId])
}

model InventoryTransaction {
  id             String        @id @default(cuid())
  itemId         String
  item           InventoryItem @relation(fields: [itemId], references: [id])
  locationId     String
  jobcardId      String?
  type           String
  qty            Int
  timestamp      DateTime      @default(now())
  createdBy      String
  destLocationId String?
  photoUrl       String?

  @@index([itemId])
  @@index([jobcardId])
}

// Custody chain for a part removed from a customer's unit during repair
// (e.g. a faulty compressor) — this exists to settle "you never gave our
// old part back" disputes, so it needs to be real, persisted evidence,
// not browser-only state.
model RemovedPart {
  id                String    @id @default(cuid())
  jobcardId         String
  jobCard           JobCard   @relation(fields: [jobcardId], references: [id])
  description       String
  serialNo          String?
  removedAt         DateTime  @default(now())
  removedBy         String
  customerNotifiedAt DateTime?
  returnStatus      String    @default("pending")
  returnConfirmedAt DateTime?
  returnConfirmedBy String?

  @@index([jobcardId])
  @@index([returnStatus])
}
